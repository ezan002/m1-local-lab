OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ORCHESTRATOR_MODEL=gpt-4.1
WEBSURFER_MODEL=gpt-4.1
APP_HOST=127.0.0.1
APP_PORT=8000
PHOENIX_HOST=127.0.0.1
PHOENIX_PORT=6006
PHOENIX_BASE_URL=http://127.0.0.1:6006
PHOENIX_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=m1-local-lab
ATTRIBUTION_DATASET_NAME=m1-local-lab-external-trace-smoke
ATTRIBUTION_EXPERIMENT_NAME=m1-local-lab-failure-attribution-mvp
# Optional explicit override; normally leave unset so the latest named experiment is selected.
# ATTRIBUTION_EXPERIMENT_ID=
PHOENIX_WORKING_DIR=./data/phoenix
PHOENIX_ALLOW_EXTERNAL_RESOURCES=false
LANGSMITH_TRACING=false
LANGGRAPH_STRICT_MSGPACK=true
HEADLESS=false
MAX_ACTIVE_RUNS=1
MAX_GRAPH_STEPS=30
MAX_MODEL_CALLS=40
MAX_REPLANS=2
MODEL_TIMEOUT_SECONDS=90
RUN_TIMEOUT_SECONDS=600
ENABLE_CODE_EXECUTION=false
ALLOWED_WEB_HOSTS=playwright.dev,microsoft.github.io,developers.openai.com
ALLOWED_FILE_DIRS=./datasets,./docs
